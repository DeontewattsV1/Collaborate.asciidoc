# Combined image: Next.js standalone (web app) + agentterm + a tiny
# reverse proxy, all started by a single entrypoint. Durable rooms and
# the secret vault use an external free Supabase Postgres (DATABASE_URL,
# GUILD_STORE=postgres as Fly secrets); Postgres and ClamAV are not run
# in this image. agentterm's log/key and the session-revocation file
# live on the existing /data volume.
#
# Non-root: the entrypoint starts as root only to chown the root-owned
# Fly volume, then re-executes itself as the image's unprivileged `node`
# user (uid 1000) with setpriv, so agentterm, Next.js and the proxy never
# run as root. (A plain USER line would leave /data unwritable.)

FROM golang:1.27.4-bookworm AS gotools
WORKDIR /src
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY fly/proxy.go ./fly/proxy.go
RUN go build -trimpath -buildvcs=false -ldflags="-s -w" -o /out/agentterm ./cmd/agentterm \
 && go build -trimpath -buildvcs=false -ldflags="-s -w" -o /out/flyproxy ./fly/proxy.go

FROM node:22-bookworm-slim AS webbuild
WORKDIR /web
COPY web/dev-guild/package.json web/dev-guild/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY web/dev-guild ./
ENV NEXT_OUTPUT=standalone
RUN npm run build

FROM node:22-bookworm-slim AS runner
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tini \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=gotools /out/agentterm /usr/local/bin/agentterm
COPY --from=gotools /out/flyproxy /usr/local/bin/flyproxy
COPY .github/agent-registry.json /etc/agentterm/agent-registry.json
COPY fly/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh /usr/local/bin/agentterm /usr/local/bin/flyproxy
COPY --from=webbuild /web/.next/standalone ./
COPY --from=webbuild /web/.next/static ./.next/static
COPY --from=webbuild /web/public ./public
RUN chown -R node:node /app/.next \
 && command -v setpriv >/dev/null
ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=127.0.0.1 \
    NODE_OPTIONS=--max-old-space-size=96
EXPOSE 8080
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
