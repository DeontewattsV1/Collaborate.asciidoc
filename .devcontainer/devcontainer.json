{
  "name": "Collaborate Sandbox (Free Tier)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.26"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "containerEnv": {
    "GOTOOLCHAIN": "auto",
    "CGO_ENABLED": "1",
    "AGENTTERM_SERVER": "http://127.0.0.1:8787"
  },
  "forwardPorts": [8787],
  "portsAttributes": {
    "8787": {
      "label": "agentterm (loopback)",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "bash scripts/sandbox/bootstrap-ubuntu.sh codespace --no-check --no-serve",
  "postStartCommand": "bash scripts/sandbox/bootstrap-ubuntu.sh codespace-start",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
