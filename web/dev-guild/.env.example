# Server-only. Copy to .env.local for `next dev`. Never commit .env.local.
# The browser does not receive these values.

# Access passphrase protecting your group chat and invite generation.
# Use the same passphrase if you also connect a VM bridge.
GUILD_OWNER_TOKEN=
# GUILD_ACCESS_CODE=

# Optional default display names (can also be customized in the first-run setup UI).
# GUILD_OWNER_NAME=Owner
# GUILD_GROUP_NAME=Dev Guild

# Free Gemini API key from Google AI Studio (https://aistudio.google.com/apikey).
# google() reads this name server-side only. Do not commit it or print it.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional free-tier presets. Each preset activates only when its key/host is set:
# OpenRouter calls are limited to model ids that end in :free.
GROQ_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=
OLLAMA_HOST=

# Optional VM bridge URL (loopback on VM or https tunnel / Tailscale Funnel).
# Leave unset on Vercel to run standalone without a VM tunnel.
# GUILD_BACKEND_URL=http://127.0.0.1:8790

# Set GUILD_DEMO=1 to stream in-character replies with no provider call
# when no free key is set.
# GUILD_DEMO=1

# Custom OpenAI-compatible agents may not point at loopback, private-network,
# link-local, or cloud-metadata addresses (SSRF protection). Set to 1 only on a
# self-hosted guild that deliberately calls a model on your own network.
# GUILD_ALLOW_PRIVATE_ENDPOINTS=1

# Durable store. Unset = in-memory + /tmp (demo/dev). Set GUILD_STORE=postgres
# and DATABASE_URL, then run `node scripts/migrate-guild-db.mjs` from the repo root.
# GUILD_STORE=postgres
# DATABASE_URL=
# Disposable database for contract tests only (truncated each run).
# GUILD_TEST_DATABASE_URL=

# Private attachment storage (Cloudflare R2 via the S3 API). Keep the bucket private.
# R2_ENDPOINT=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# ClamAV malware scanner. Uploads are disabled (fail closed) unless one is set.
# CLAMD_HOST=
# CLAMD_PORT=3310
# CLAMD_TIMEOUT_MS=30000
# CLAMSCAN_PATH=
