# Server-only. Copy to .env.local for `next dev`. Never commit .env.local.
# The browser does not receive these values.

# Same passphrase the VM's guild serve uses.
GUILD_OWNER_TOKEN=

# Loopback on the VM, or the https tunnel / Tailscale Funnel URL. No path.
GUILD_BACKEND_URL=http://127.0.0.1:8790

# Vercel AI Gateway. When this is set, group-chat replies use the AI SDK
# (generateText / streamText) and a gateway model string. When it is empty,
# or the gateway returns an error (a new key answers 403 until a credit card
# is on file in Vercel), the VM answers with its own provider keys instead.
AI_GATEWAY_API_KEY=

# Optional. Defaults to google/gemini-2.5-flash-lite.
GUILD_GATEWAY_MODEL=google/gemini-2.5-flash-lite
