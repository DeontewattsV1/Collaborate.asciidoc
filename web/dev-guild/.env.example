# Server-only. Copy to .env.local for `next dev`. Never commit .env.local.
# The browser does not receive these values.

# Access passphrase protecting your group chat and invite generation.
# Use the same passphrase if you also connect a VM bridge.
GUILD_OWNER_TOKEN=
# GUILD_ACCESS_CODE=

# Optional default display names (can also be customized in the first-run setup UI).
# GUILD_OWNER_NAME=Owner
# GUILD_GROUP_NAME=Dev Guild

# Free Gemini API key from Google AI Studio (https://aistudio.google.com/apikey).
# google() reads this name server-side only. Do not commit it or print it.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional free-tier presets. Each preset activates only when its key/host is set:
# OpenRouter calls are limited to model ids that end in :free.
GROQ_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=
OLLAMA_HOST=

# Optional VM bridge URL (loopback on VM or https tunnel / Tailscale Funnel).
# Leave unset on Vercel to run standalone without a VM tunnel.
# GUILD_BACKEND_URL=http://127.0.0.1:8790

# Set GUILD_DEMO=1 to stream in-character replies with no provider call
# when no free key is set.
# GUILD_DEMO=1
